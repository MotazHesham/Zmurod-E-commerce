                $.validator.addMethod("validateId", function(value, element) {
                    var identity = $("#identity").val();
                    if (identity === "saudi") {
                        return /^1[0-9]{9}$/.test(value);
                    } else if (identity === "resident") {
                        return /^2[0-9]{9}$/.test(value);
                    }
