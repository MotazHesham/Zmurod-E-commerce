                $('#seller_type').change(function() {
                    var sellerType = $(this).val();
                    
                    // Hide all conditional fields
                    $('#organization_name_field').hide();
                    $('#parent_organization_field').hide();
                    
                    // Clear validation
                    $('#organization_name').removeClass('is-invalid');
                    $('#organization_id').removeClass('is-invalid');
                    
                    // Show relevant fields based on selection
                    if (sellerType === 'organization') {
                        $('#organization_name_field').show();
                        $('#organization_name').attr('required', true);
                        $('#organization_id').attr('required', false);
                    } else if (sellerType === 'affiliated') {
                        $('#parent_organization_field').show();
                        $('#organization_id').attr('required', true);
                        $('#organization_name').attr('required', false);
                    } else {
                        $('#organization_name').attr('required', false);
                        $('#organization_id').attr('required', false);
                    }
                });

                // Trigger change on page load to set initial state
                $('#seller_type').trigger('change');

                // Document type selection logic
                $('#document_type').change(function() {
                    var documentType = $(this).val();
                    
                    // Hide all document fields
                    $('#commercial_register_fields').hide();
                    $('#freelance_work_fields').hide();
                    
                    // Clear validation for document fields
                    $('#commercial_register_document, #commercial_register_expiry, #commercial_register_number, #tax_number').removeClass('is-invalid');
                    $('#freelance_work_document, #freelance_work_number').removeClass('is-invalid');
                    
                    // Show relevant fields based on selection
                    if (documentType === 'commercial_register') {
                        $('#commercial_register_fields').show();
                        $('#commercial_register_document, #commercial_register_expiry, #commercial_register_number, #tax_number').attr('required', true);
                        $('#freelance_work_document, #freelance_work_number').attr('required', false);
                    } else if (documentType === 'freelance_work') {
                        $('#freelance_work_fields').show();
                        $('#freelance_work_document, #freelance_work_number').attr('required', true);
                        $('#commercial_register_document, #commercial_register_expiry, #commercial_register_number, #tax_number').attr('required', false);
                    } else {
                        $('#commercial_register_document, #commercial_register_expiry, #commercial_register_number, #tax_number').attr('required', false);
                        $('#freelance_work_document, #freelance_work_number').attr('required', false);
                    }
                });

                // Trigger change on page load to set initial state
                $('#document_type').trigger('change');

                // Description character counter
                $('#description').on('input', function() {
                    var length = $(this).val().length;
                    $('#desc-count').text(length);
                });
                
            });
        
        
   

        // Global validation triggers (customer form)
        (function ensureCustomerValidator() {
            function init() {
                $(document).on('blur change keyup', '#custome-form input, #custome-form select, #custome-form textarea', function() {
                    $(this).valid();
                });
            }
            if (!$.validator || !$.fn.validate) {
                $(document).one('validator:ready', init);
            } else {
                init();
            }
        })();
    </script>
    <script>
        $(document).ready(function() {

            var inputs = document.querySelectorAll(".customer_phone");

            if (window.intlTelInput && typeof window.intlTelInput === 'function') {
                inputs.forEach(function(input) {
                    window.intlTelInput(input, {
                        initialCountry: "sa",
                        preferredCountries: ["sa", "eg", "ae", "kw"],
                        separateDialCode: true,
                        utilsScript: '{{ asset('vendor/intl-tel-input/js/utils.js') }}'
                    });
                });
            }
        });
    </script>
    <script>
        $(document).ready(function() {
            $('#type').on('change', function() {
                if ($(this).val() == 'oragainzation') {
                    $('#org-container').removeClass('d-none');
                } else {
                    $('#org-container').addClass('d-none');
                }
            });
        });
    </script>
@endsection
