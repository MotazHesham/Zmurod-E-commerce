                }, "يرجى اختيار الهوية أولاً.");

             
                // Show validation on blur/change/keyup
                $(document).on('blur change keyup', '#seller-form input, #seller-form select, #seller-form textarea', function() {
                    $(this).valid();
                });

                // live validate + move to next field
                function attachNextFieldFlow($form) {
                    var selector = 'input, select, textarea';
                    $form.on('blur', selector, function() {
                        var $el = $(this);
                        $el.valid();
                        if ($el.valid()) {
                            var $fields = $form.find(selector).filter(':visible:enabled');
                            var idx = $fields.index($el);
                            if (idx > -1 && idx + 1 < $fields.length) {
                                $fields.eq(idx + 1).focus();
                            }
                        }
                    });
                    $form.on('keydown', selector, function(e) {
                        if (e.key === 'Enter') {
                            e.preventDefault();
                            var $el = $(this);
                            $el.valid();
                            if ($el.valid()) {
                                var $fields = $form.find(selector).filter(':visible:enabled');
                                var idx = $fields.index($el);
                                if (idx > -1 && idx + 1 < $fields.length) {
                                    $fields.eq(idx + 1).focus();
                                } else {
                                    $form.trigger('submit');
                                }
                            }
                        }
                    });
                }

                attachNextFieldFlow($("#seller-form"));

