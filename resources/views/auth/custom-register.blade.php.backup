        .tab-loading-overlay.show { display: flex; }
        /* CTA button styling */
        .btn-cta { background: #242424; color: #fff; border: 1px solid #242424; box-shadow: 0 6px 16px rgba(0,0,0,0.15); transition: transform .15s ease, box-shadow .15s ease, background .2s ease, border-color .2s ease; }
        .btn-cta:hover { transform: translateY(-1px); box-shadow: 0 10px 20px rgba(0,0,0,0.2); background: #303030; border-color: #ea9300; }
        .btn-cta:active { transform: translateY(0); }
